 "definitions": {
  "latency": "client-side wall time per request, request sent to answer parsed; compare only rows with the same requests_in_flight",
  "api_cost_per_1000_usd_list_price": "billed input tokens x the provider's list price (price_source, price_date), per 1,000 questions; not an invoice; null on own GPU, and null with its rate, source and date where no public price page backs that exact model's rate (checked 13 Nov): unverified, not zero",
  "gpu_seconds_per_1000": "measured wall time of the whole run on one GPU (model load excluded) over all pairs it answered, per 1,000 questions: a rate, not a cohort share; own GPU only, not comparable with API dollars",
  "recall": "of all gold pairs with that label, the share labelled so; an invalid reply counts as missed",
  "wrong_answer_recall": "recall_other: texts stating a conflicting answer that were flagged 'other'",
  "false_alarm_rate": "gold 'reference' or 'none' pairs labelled 'other', over false_alarm_pairs; invalid replies are not counted as correct rejections, so 1 - false_alarm_rate is not an accuracy; read it beside invalid",
  "invalid": "replies without a usable label (chat: no final ANSWER line), counted wrong",
  "probabilities": "this run's records hold per-option probabilities for every pair; says nothing about other runs of the model; no confidence is derived for chat models; calibration_error stays in bench-scores.json"
 },
