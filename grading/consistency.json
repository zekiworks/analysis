 "definitions": {
  "forms": "each no-code pair asked again: 'control' the scored request unchanged; 'order1', 'order2' the three options in two different changed orders (the same orders for every model); 'names' the options' keys replaced by plain letters in reverse; 'dontknow' the not-stated option reworded. Question, reference answer and text never change. Exception: where a model's server reorders options itself (its 'applicability' says so), a form reaches the model as that order, not as sent",
  "applicability": "per model and form, set only where the form did not reach the model as defined; such a cell is not comparable with other models' cells, and its figures are observations only",
  "flip_rate": "share of pairs whose chosen option, by meaning, differs from the model's own scored Answer Check run",
  "mean_confidence_change": "mean absolute change in the probability the model gives its scored run's pick",
  "control": "the scored request repeated unchanged on the consistency load, read against the model's scored run: a difference can come from the setup as well as from repetition (see a model's note); the other forms are read against it",
  "model_echo_checked": "true when every reply named the same model as the scored run's replies; false when the model's replies name none, so the load's pinned weights are the identity evidence",
  "scope": "our-GPU decision models only, each on the same pinned weights and server software as its scored run unless its note says otherwise, one request at a time; separate from every score, the ranking and the Decision Index"
 },
 "not_included": {
  "claim_negation": "the form with the reference answer rewritten to its opposite (plan #12220) is not run: its rewrites need review first",
  "hosted_models": "hosted decision APIs are not run (their budget is not approved)",
  "models": {
   "glide-27b": "in Ümit's priority six (#12404) but not run: its Answer Check row was scored on a DGX Spark, and the consistency load ran on an RTX PRO 6000, so it would not be its scored setup",
   "glide-9b": "not run: its Answer Check row was scored in a vLLM image, not the glide.server load",
   "knowline-31b-gen1.5": "not run: its Answer Check row was scored on a DGX Spark (SGLang), not this card",
   "d3, d3-ultra, onejev, open-jev, drex-max-v1": "not run: no Answer Check row to compare against"
  }
 },
